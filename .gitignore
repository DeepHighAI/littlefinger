# 미리보기·검증 과정에서 생기는 산출물
.playwright-mcp/
.superpowers/
.worktrees/
*.png
!design-reference/**/*.png
!apps/mobile/assets/images/*.png
!apps/web/src/assets/images/*.png
!apps/web/public/brand/*.png
!docs/디자인/icon-proposals/*.png
!docs/디자인/store/**/*.png

# 빌드·테스트 산출물
dist/
coverage/
.expo/
.vite/
.firebase/

# 환경변수 — .env.example 만 커밋한다 (04 §9)
.env
.env.*
!.env.example

# Supabase CLI 의 로컬 연결 상태. `supabase link` 가 만든다.
# **pooler-url 에 DB 접속 비밀번호가 평문으로 들어간다.** 머신마다 다시 만들어지는 값이므로
# 저장소에 들어갈 이유가 없고, 들어가면 키를 즉시 회전해야 한다(04 §9).
supabase/.temp/

# 에디터 · OS
.DS_Store
Thumbs.db
.claude/settings.local.json
# 에이전트 로컬 MCP 설정. 머신마다 달라지는 값이라 저장소에 둘 이유가 없다.
.codex/
node_modules/

# Expo
.expo/
android/
ios/
*.jks
*.keystore

# 공개 클라이언트 설정과 달리 Firebase 서버 자격 증명은 절대 커밋하지 않는다.
**/*-firebase-adminsdk-*.json
**/firebase-service-account*.json

# Google Play 구매 검증용 GCP 서비스 계정 키(purchase-verify). Supabase Secrets 에만 넣는다.
**/*service-account*.json
**/*serviceaccount*.json

# Pretendard 원본 배포판(67MB). 앱이 쓰는 4종은 apps/mobile/assets/fonts/ 에 있다.
# 배포판 전체를 저장소에 두면 모든 클론이 그 비용을 영구히 낸다.
/fonts/
.gstack/

# EAS Submit 이 쓰는 Play 서비스 계정 키. eas.json 의 serviceAccountKeyPath 가 여기를 가리킨다.
apps/mobile/.secrets/
