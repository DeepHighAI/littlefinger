{
  // 테스트도 §3 의 strict 플래그를 그대로 받는다. vitest 는 타입을 보지 않고 트랜스파일만
  // 하므로, 이 프로젝트가 없으면 테스트 코드의 타입 오류는 아무도 보지 못한다.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Request·Response 는 껍데기 테스트가 직접 만든다. node: 모듈은 하니스가 쓴다.
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
