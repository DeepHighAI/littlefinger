{
  "name": "littlefinger",
  "version": "0.1.0",
  "private": true,
  "description": "리틀핑거 — 상호 약속 관리 서비스.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "preview": "node design-reference/serve.js",
    "test": "vitest run && npm run test --workspace=@littlefinger/mobile",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/mobile && tsc --noEmit -p apps/web && tsc --noEmit -p supabase/functions && tsc --noEmit -p supabase/tests",
    "build:web": "npm run build --workspace=@littlefinger/web",
    "sync:agents": "node tools/sync-agent-docs.js",
    "check:agents": "node tools/sync-agent-docs.js --check",
    "test:shared": "vitest run",
    "test:mobile": "npm run test --workspace=@littlefinger/mobile"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@supabase/supabase-js": "2.110.8",
    "fontkit": "^2.0.4",
    "subset-font": "^2.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
